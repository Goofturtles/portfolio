 "app": {
  "_about": "Our own app icons: one per place and one per outside page, drawn in the manner of Windows 11 and Office app icons (flat, one hue, a 7 % top-to-bottom shade, a 1 px top highlight, a white or gold symbol with a whisper of shadow). Every id has its own silhouette (tile, circle, folder, bubble, the service's own shape) at the same visual weight. shape: tile | circle | folder | bubble | youtube. hue: the one colour. glyph: a Fluent System Icons FILLED 24 drawing; box: its drawn extent [x, y, w, h] in the 24 grid; frac: its larger side as a share of the shape; nudge: optical centring in 48-grid units; ink: the symbol colour (white if absent). mark: one of the drawings in tools/sync_icons.cjs (our A, and the four services' own marks). The art is written to media/icons/app/<id>.svg and to js/icons.gen.js; 'app' is the portfolio's own place (Home).",
  "app": { "shape": "tile", "hue": "#0F6CBD", "mark": "arjun" },
  "ai": { "shape": "circle", "hue": "#0FA3B1", "glyph": "search_sparkle", "box": [2, 0, 21, 23], "frac": 0.62, "nudge": [0.3, 0.4] },
  "projects": { "shape": "folder", "hue": "#F5A700" },
  "films": { "shape": "circle", "hue": "#E5532D", "glyph": "play", "box": [5, 3.3, 16.7, 17.4], "frac": 0.5, "nudge": [1.2, 0] },
  "how": { "shape": "tile", "hue": "#7A5AF8", "glyph": "shapes", "box": [2, 2, 20, 20], "frac": 0.65 },
  "results": { "shape": "tile", "hue": "#3B4A6B", "glyph": "trophy", "box": [3, 2, 18, 20], "frac": 0.74, "ink": "#F5C24B" },
  "about": { "shape": "circle", "hue": "#2D7FF9", "glyph": "person", "box": [4, 2, 16, 20], "frac": 0.52, "nudge": [0, 0.6] },
  "contact": { "shape": "bubble", "hue": "#25A85A" },
  "github": { "shape": "circle", "hue": "#24292F", "mark": "github", "frac": 0.7, "edge": true },
  "linkedin": { "shape": "tile", "hue": "#0A66C2", "mark": "linkedin", "frac": 0.62 },
  "medium": { "shape": "tile", "hue": "#1A1A1A", "mark": "medium", "frac": 0.64, "edge": true },
  "youtube": { "shape": "youtube", "hue": "#FF0000", "mark": "youtube" }
 },
